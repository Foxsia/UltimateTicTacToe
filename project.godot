; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Control",
"class": "CellView",
"language": "GDScript",
"path": "res://scripts/cell/cell.gd"
}, {
"base": "Node",
"class": "CursorManager",
"language": "GDScript",
"path": "res://scripts/core/cursor_manager.gd"
}, {
"base": "Node",
"class": "GameManager",
"language": "GDScript",
"path": "res://scripts/core/game_manager.gd"
}, {
"base": "Reference",
"class": "GameRules",
"language": "GDScript",
"path": "res://scripts/core/game_rules.gd"
}, {
"base": "Reference",
"class": "GameState",
"language": "GDScript",
"path": "res://scripts/core/game_state.gd"
}, {
"base": "Node",
"class": "InputManager",
"language": "GDScript",
"path": "res://scripts/core/input_manager.gd"
}, {
"base": "GridContainer",
"class": "MainBoardView",
"language": "GDScript",
"path": "res://scripts/game/mainBoard.gd"
}, {
"base": "GridContainer",
"class": "SmallBoardView",
"language": "GDScript",
"path": "res://scripts/game/smallBoard.gd"
} ]
